# -*- mode: makefile-gmake -*-
BH=@BH@
RCPP=@RCPP@
EG=@EG@
SH=@SH@
CXX_STD = CXX17
################################################################################
## Package library flags.
PKG_LIBS    = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS)

# Release options
PKG_CFLAGS  =  -D_isrxode2parse_
# -DSTAN_MATH_REV_CORE_INIT_CHAINABLESTACK_HPP keeps stan-math's TBB
# ad_tape_observer out of the build, so nothing links or loads TBB (loading it
# is what CRAN's gcc-UBSAN check reports); rx_stan_math_thread_init_rev_autodiff()
# in llik2.h creates each thread's AD tape before every jacobian().  The
# reduce_sum/map_rect guards keep out TBB's partitioner.h, whose non-inline
# static functions call libtbb and survive -O0 builds (covr, load_all()).
RXLL_NO_TBB = -DSTAN_MATH_REV_CORE_INIT_CHAINABLESTACK_HPP -DSTAN_MATH_PRIM_FUNCTOR_REDUCE_SUM_HPP -DSTAN_MATH_PRIM_FUNCTOR_REDUCE_SUM_STATIC_HPP -DSTAN_MATH_REV_FUNCTOR_REDUCE_SUM_HPP -DSTAN_MATH_REV_FUNCTOR_MAP_RECT_CONCURRENT_HPP
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DSTAN_THREADS $(RXLL_NO_TBB) -D_isrxode2parse_ -DBOOST_DISABLE_ASSERTS -DBOOST_PHOENIX_NO_VARIADIC_EXPRESSION -D_HAS_AUTO_PTR_ETC=0 -D_REENTRANT -@ISYSTEM@"$(BH)" -@ISYSTEM@"$(EG)" $(SH) -@ISYSTEM@"$(RCPP)"
