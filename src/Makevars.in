# -*- mode: makefile-gmake -*-
BH=@BH@
RCPP=@RCPP@
EG=@EG@
SH=@SH@
CXX_STD = CXX17
################################################################################
## Package library flags.
PKG_LIBS    = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS)

# Release options
PKG_CFLAGS  =  -D_isrxode2parse_ -MMD -MP
# -DSTAN_MATH_REV_CORE_INIT_CHAINABLESTACK_HPP keeps stan-math's TBB
# ad_tape_observer out of the build, so nothing links or loads TBB (loading it
# is what CRAN's gcc-UBSAN check reports); rx_stan_math_thread_init_rev_autodiff()
# in llik2.h creates each thread's AD tape before every jacobian().  The
# reduce_sum/map_rect guards keep out TBB's partitioner.h, whose non-inline
# static functions call libtbb and survive -O0 builds (covr, load_all()).
RXLL_NO_TBB = -DSTAN_MATH_REV_CORE_INIT_CHAINABLESTACK_HPP -DSTAN_MATH_PRIM_FUNCTOR_REDUCE_SUM_HPP -DSTAN_MATH_PRIM_FUNCTOR_REDUCE_SUM_STATIC_HPP -DSTAN_MATH_REV_FUNCTOR_REDUCE_SUM_HPP -DSTAN_MATH_REV_FUNCTOR_MAP_RECT_CONCURRENT_HPP
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DSTAN_THREADS $(RXLL_NO_TBB) -D_isrxode2parse_ -DBOOST_DISABLE_ASSERTS -DBOOST_PHOENIX_NO_VARIADIC_EXPRESSION -D_HAS_AUTO_PTR_ETC=0 -D_REENTRANT -@ISYSTEM@"$(BH)" -@ISYSTEM@"$(EG)" $(SH) -@ISYSTEM@"$(RCPP)" -MMD -MP

################################################################################
## Header dependency tracking.
##
## R's build rules make an object depend on its own source only, so an object
## goes stale -- silently -- when a header it includes changes and the source
## does not.  That reaches across packages too: a LinkingTo package's headers
## are just another include path, so a struct that changes there leaves the
## objects here compiled to the previous layout.
##
## -MMD (in PKG_CFLAGS/PKG_CXXFLAGS above) records each object's headers in a
## .d file beside it; -MP emits a phony target per header so one that is later
## renamed or deleted does not break the build.  The .d files the previous
## build wrote are read back below.
##
## Makevars is read before shlib.mk defines "all", so without .DEFAULT_GOAL the
## first target of the first .d file becomes make's default goal and the shared
## library is never linked.
################################################################################
.DEFAULT_GOAL := all
-include $(wildcard *.d)
