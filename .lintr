linters: linters_with_defaults(
    # Based on rxode2's lintr rules (see nlmixr2/rxode2 .lintr).
    object_name_linter(
      styles = "camelCase",
      regexes = c(
        internal = "^\\.[a-z][a-zA-Z0-9]*$",
        s3 = "^[a-z][a-z0-9_]*\\.[a-zA-Z][a-zA-Z0-9]*$"
      )
    ),
    assignment_linter(),
    line_length_linter(120),
    whitespace_linter(),
    pipe_continuation_linter(),
    T_and_F_symbol_linter(),
    cyclocomp_linter(50),
    # rxode2 disables these for its violation backlog; air formats spacing, so
    # rxode2ll has none and keeps them on.
    infix_spaces_linter(),
    commas_linter(),
    # air owns indentation, and indentation_linter disagrees with air's layout
    # of wrapped operands, so formatted code could still fail lint.
    indentation_linter = NULL
  )
exclusions: list(
    # Generated by Rcpp::compileAttributes().
    "R/RcppExports.R"
  )
encoding: "UTF-8"
